# Copy to .env on the server and fill in. Never commit the real .env.

# ── Domains (DNS A records must point at this server) ────────────────────────
SITE_DOMAIN=wedding.example.com
API_DOMAIN=api.wedding.example.com

# ── Postgres ─────────────────────────────────────────────────────────────────
DB_DATABASE=e-wedding
DB_USER=admin
# openssl rand -hex 24
DB_PASSWORD=

# ── Directus ─────────────────────────────────────────────────────────────────
# openssl rand -hex 32
DIRECTUS_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Website ──────────────────────────────────────────────────────────────────
# Printed once by scripts/setup.mjs (README step 4)
NUXT_DIRECTUS_TOKEN=

# ── Optional ─────────────────────────────────────────────────────────────────
# Image tags to run. "develop" follows the latest build; set a sha-<commit>
# tag to pin or roll back.
# WEB_TAG=develop
# API_TAG=develop
# Change only if 80/443 are taken on the server
# HTTP_PORT=80
# HTTPS_PORT=443
